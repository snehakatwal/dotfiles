[global]
    monitor = 0
    follow = mouse
    width = 320
    height = 300
    origin = top-right
    offset = 12x44
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 15
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 15
    separator_height = 2
    separator_color = frame
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#7aa2f7"
    sort = yes

    font = JetBrains Mono Nerd
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = fals
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    corner_radius = 10
    mouse_left_click = close_cu
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_a

[urgency_low]
    background = "#1a1b26e6"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 5

[urgency_normal]
    background = "#1a1b26f2"
    foreground = "#c0caf5"
    frame_color = "#bb9af7"
    timeout = 8

[urgency_critical]
    background = "#1a1b26f2"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    timeout = 0
